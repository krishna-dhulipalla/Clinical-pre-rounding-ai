OPENAI_API_KEY=sk-proj-...
DATABASE_URL=postgresql://admin:admin@localhost:5432/fhir_rag_audit
FHIR_BASE_URL=http://localhost:8080/fhir

# v2: synthetic replay works without Docker or an API key.
WORKBENCH_MODE=demo
WORKBENCH_PUBLIC_URL=http://localhost:8000
WORKBENCH_AUTO_MIGRATE=true
WORKBENCH_EMBEDDED_WORKER=true
WORKBENCH_HOSTED_LLM=false
WORKBENCH_MODEL=gpt-4o-mini
# Optional: WORKBENCH_DATABASE_URL=postgresql://user:password@localhost:5432/workbench
# Optional estimated API prices, supplied by the operator in USD per million tokens:
# WORKBENCH_INPUT_USD_PER_MILLION=
# WORKBENCH_OUTPUT_USD_PER_MILLION=

# FHIR mode: disable automatic migrations and configure scoped access.
# WORKBENCH_API_TOKEN=<at least 32 random characters>
# WORKBENCH_PATIENT_IDS=patient-1,patient-2
# WORKBENCH_FHIR_TOKEN=<upstream FHIR service token>
# WORKBENCH_SECURE_COOKIES=true

# SMART sandbox browser launch (public client + PKCE):
# WORKBENCH_SESSION_KEY=<Fernet key, see docs/smart_on_fhir_setup.md>
# SMART_CLIENT_ID=
# SMART_FHIR_URL=
# SMART_AUTHORIZATION_URL=
# SMART_TOKEN_URL=
